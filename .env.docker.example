# Copy to .env before running Docker Compose. Never commit the real .env file.
COMPOSE_PROJECT_NAME=marc-chatbot
FRONTEND_PORT=8080
BACKEND_IMAGE=marc-chatbot-backend:local
FRONTEND_IMAGE=marc-chatbot-frontend:local
ADMIN_TOKEN=replace-with-a-high-entropy-token
BOT_DRIVER=mock
WECHATY_PUPPET_SERVICE_TOKEN=
